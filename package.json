{
  "name": "pilion-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop browser for ACP agents: connect Claude Code, Codex, Gemini CLI, OpenCode, Pi or Grok Build, locally or over SSH, and let them drive the browser through MCP with approvals, takeover and session resume.",
  "author": {
    "name": "echoVic",
    "email": "137844255@qq.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/echoVic/pilion-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/echoVic/pilion-browser.git"
  },
  "type": "module",
  "main": "electron-main.cjs",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 file:dist/main/main/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "pnpm run typecheck && vite build && tsc -p tsconfig.main.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "electron .",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@assistant-ui/react": "0.15.18",
    "@modelcontextprotocol/sdk": "1.30.0",
    "lucide-react": "^1.41.0",
    "pino": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.63.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "44.4.2",
    "electron-builder": "26.15.3",
    "eslint": "latest",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "latest",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
