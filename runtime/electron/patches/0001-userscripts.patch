+bool Extensions::GetUserScriptsAllowed(gin_helper::ErrorThrower thrower,
+                                       const std::string& extension_id) {
+  const auto* extension = extensions::ExtensionRegistry::Get(browser_context())
+                              ->enabled_extensions()
+                              .GetByID(extension_id);
+  if (!extension) {
+    thrower.ThrowError("Extension is not loaded in this session");
+    return false;
+  }
+  return extensions::ExtensionSystem::Get(browser_context())
+      ->user_script_manager()
+      ->AreUserScriptsAllowed(*extension);
