+void Extensions::SetUserScriptsAllowed(gin_helper::ErrorThrower thrower,
+                                       const std::string& extension_id,
+                                       bool allowed) {
+  const auto* extension = extensions::ExtensionRegistry::Get(browser_context())
+                              ->enabled_extensions()
+                              .GetByID(extension_id);
+  if (!extension) {
+    thrower.ThrowError("Extension is not loaded in this session");
+    return;
+  }
+  if (!extension->permissions_data()->HasAPIPermission(
+          extensions::mojom::APIPermissionID::kUserScripts)) {
+    thrower.ThrowError("Extension does not have the userScripts permission");
+    return;
+  }
+  // Chromium persists consent and updates dynamic script sources, renderer
+  // bindings and already-running extension service worker bindings together.
+  extensions::ExtensionSystem::Get(browser_context())
+      ->user_script_manager()
+      ->SetUserScriptPrefEnabled(extension_id, allowed);
+}
