 namespace extensions {
 
+namespace {
+
+// Keep a separate profile-backed sync area using Chromium's native quota and
+// change-event dispatch. Electron has no browser-account synchronization.
+class ProfileSyncStoreCache final : public ValueStoreCache {
+ public:
+  explicit ProfileSyncStoreCache(
+      scoped_refptr<value_store::ValueStoreFactory> factory)
+      : factory_(std::move(factory)) {}
+  ~ProfileSyncStoreCache() override = default;
+
+  void RunWithValueStoreForExtension(
+      StorageCallback callback,
+      scoped_refptr<const Extension> extension) override {
+    auto& store = stores_[extension->id()];
+    if (!store) {
+      const auto model = extension->is_app()
+                             ? value_store_util::ModelType::APP
+                             : value_store_util::ModelType::EXTENSION;
+      const SettingsStorageQuotaEnforcer::Limits limits = {
+          static_cast<size_t>(api::storage::sync::QUOTA_BYTES),
+          static_cast<size_t>(api::storage::sync::QUOTA_BYTES_PER_ITEM),
+          static_cast<size_t>(api::storage::sync::MAX_ITEMS)};
+      store = std::make_unique<SettingsStorageQuotaEnforcer>(
+          limits, value_store_util::CreateSettingsStore(
+                      settings_namespace::SYNC, model, extension->id(),
+                      factory_));
+    }
+    std::move(callback).Run(store.get());
+  }
+
+  void DeleteStorageSoon(const ExtensionId& id) override {
+    stores_.erase(id);
+    value_store_util::DeleteValueStore(settings_namespace::SYNC,
+                                       value_store_util::ModelType::APP, id,
+                                       factory_);
+    value_store_util::DeleteValueStore(settings_namespace::SYNC,
+                                       value_store_util::ModelType::EXTENSION,
+                                       id, factory_);
+  }
+
+ private:
+  const scoped_refptr<value_store::ValueStoreFactory> factory_;
+  std::map<ExtensionId, std::unique_ptr<SettingsStorageQuotaEnforcer>> stores_;
+};
+
+}  // namespace
