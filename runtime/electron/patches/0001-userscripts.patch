+/* global chrome */
+// Deliberately never register a script here: the restart test must use the store.
+chrome.runtime.onUserScriptMessage.addListener((message, sender, sendResponse) => {
+  sendResponse({ nonce: message.nonce, extensionId: sender.id, url: sender.url });
+});
+
+const workerInstance = crypto.randomUUID();
+chrome.runtime.onMessage.addListener((message, _sender, sendResponse) => {
+  if (message.command === 'userScriptsAvailable') {
+    sendResponse({ available: typeof chrome.userScripts === 'object', workerInstance });
+  }
+});
diff --git a/spec/fixtures/extensions/user-scripts/main.js b/spec/fixtures/extensions/user-scripts/main.js
new file mode 100644
index 0000000000000000000000000000000000000000..00b015cac2219202bf65887a97ae1dc9e70c00b6
--- /dev/null
+++ b/spec/fixtures/extensions/user-scripts/main.js
@@ -0,0 +1,138 @@
+const { app, BrowserWindow, session } = require('electron');
+const assert = require('node:assert/strict');
+const http = require('node:http');
+const path = require('node:path');
+const { once } = require('node:events');
+
+if (process.platform === 'darwin' && process.env.PILION_E2E_NO_FOCUS === '1') {
+  app.setActivationPolicy('accessory');
+}
+
+const [profile, phase] = process.argv.slice(2);
+app.setPath('userData', profile);
+let server;
+let controller;
+let target;
+
+async function waitFor(expression) {
+  return controller.webContents.executeJavaScript(`new Promise((resolve, reject) => {
+    const deadline = Date.now() + 10000;
+    const poll = async () => {
+      try {
+        const value = await (${expression});
+        if (value) return resolve(value);
+        if (Date.now() > deadline) return reject(new Error('Timed out: ' + ${JSON.stringify(expression)}));
+        setTimeout(poll, 20);
+      } catch (error) { reject(error); }
+    };
+    poll();
+  })`);
+}
+
+app.whenReady().then(async () => {
+  const custom = session.fromPartition('persist:native-userscripts');
+  const extension = await custom.extensions.loadExtension(path.join(__dirname, 'extension'));
+  controller = new BrowserWindow({ show: false, webPreferences: { session: custom, sandbox: true, contextIsolation: true, nodeIntegration: false } });
+  await controller.loadURL(`${extension.url}controller.html`);
+  const run = code => controller.webContents.executeJavaScript(code);
+  custom.extensions.setActiveTabId(controller.webContents.id);
+  assert.deepEqual(await run('chrome.tabs.query({ active: true }).then(tabs => tabs.map(tab => tab.id))'),
+    [controller.webContents.id]);
+  if (phase === 'register') {
+    let created;
+    custom.extensions.setTabCreationHandler((id, url, active) => {
+      assert.equal(id, extension.id);
+      assert.equal(url, `${extension.url}controller.html`);
+      assert.equal(active, true);
+      created = new BrowserWindow({ show: false, webPreferences: { session: custom, sandbox: true, contextIsolation: true, nodeIntegration: false } });
+      return created.webContents.id;
+    });
+    try {
+      const fresh = await run('chrome.tabs.create({ url: "controller.html" }).then(tab => tab.id)');
+      assert.equal(fresh, created.webContents.id);
+      await assert.rejects(run('chrome.tabs.create({ url: "file:///tmp/pilion-fixture" })'), /calling extension/);
+    } finally {
+      created?.destroy();
+    }
+    await run('chrome.storage.local.set({ fixtureKey: "local" })');
+    await run('chrome.storage.sync.set({ fixtureKey: "sync" })');
+  }
+  assert.equal(await run('chrome.storage.local.get("fixtureKey").then(items => items.fixtureKey)'), 'local');
+  assert.equal(await run('chrome.storage.sync.get("fixtureKey").then(items => items.fixtureKey)'), 'sync');
+
+  assert.equal(typeof custom.extensions.setUserScriptsAllowed, 'function');
+  const beforeWorker = await run(`chrome.runtime.sendMessage({ command: 'userScriptsAvailable' })`);
+  if (phase === 'register') {
+    assert.equal(beforeWorker.available, false);
+    assert.equal(custom.extensions.getUserScriptsAllowed(extension.id), false);
+    const denied = await run(`(async () => {
+      try { await chrome.userScripts.register([{ id: 'denied', matches: ['http://127.0.0.1/*'], js: [{ code: 'throw new Error("denied script ran")' }] }]); return false; }
+      catch { return true; }
+    })()`);
+    assert.equal(denied, true);
+    custom.extensions.setUserScriptsAllowed(extension.id, true);
+  } else {
+    assert.equal(custom.extensions.getUserScriptsAllowed(extension.id), phase !== 'revoked');
+  }
+
+  if (phase !== 'revoked') {
+    await waitFor('typeof chrome.userScripts === "object"');
+    await waitFor(`chrome.runtime.sendMessage({ command: 'userScriptsAvailable' }).then(reply => reply.available)`);
+    const afterWorker = await run(`chrome.runtime.sendMessage({ command: 'userScriptsAvailable' })`);
+    assert.equal(afterWorker.workerInstance, beforeWorker.workerInstance);
+    if (phase === 'register') {
+      await run(`chrome.userScripts.configureWorld({ messaging: true, csp: "script-src 'self'" })`);
+      const source = `globalThis.pilionUserScriptPrivate = true;
+        document.documentElement.dataset.nativeUserscript = 'executed';
+        chrome.runtime.sendMessage({ nonce: 'native-world-message' }, response => {
+          document.documentElement.dataset.nativeUserscriptMessage = JSON.stringify(response);
+        });`;
+      await run(`chrome.userScripts.register([{ id: 'persistent-native', matches: ['http://127.0.0.1/*'], excludeMatches: ['http://127.0.0.1/unmatched*'], runAt: 'document_end', world: 'USER_SCRIPT', js: [{ code: ${JSON.stringify(source)} }] }])`);
+    }
+    await waitFor(`chrome.userScripts.getScripts().then(scripts => scripts.length === 1 && scripts[0].id === 'persistent-native')`);
+    if (phase === 'revoke') {
+      custom.extensions.setUserScriptsAllowed(extension.id, false);
+    }
+  } else {
+    assert.equal(await run('typeof chrome.userScripts'), 'undefined');
+    assert.equal(beforeWorker.available, false);
+  }
+
+  server = http.createServer((_req, res) => res.end('<!doctype html><title>userScripts target</title><body>unchanged</body>'));
+  server.listen(0, '127.0.0.1');
+  await once(server, 'listening');
+  target = new BrowserWindow({ show: false, webPreferences: { session: custom, sandbox: true, contextIsolation: true, nodeIntegration: false } });
+  await target.loadURL(`http://127.0.0.1:${server.address().port}/target`);
+  const shouldExecute = phase === 'register' || phase === 'restore';
+  const value = await target.webContents.executeJavaScript('document.documentElement.dataset.nativeUserscript');
+  assert.equal(value, shouldExecute ? 'executed' : undefined);
+  assert.equal(await target.webContents.executeJavaScript('typeof globalThis.pilionUserScriptPrivate'), 'undefined');
+  if (shouldExecute) {
+    const reply = await target.webContents.executeJavaScript(`new Promise((resolve, reject) => {
+      const deadline = Date.now() + 10000;
+      const poll = () => {
+        const value = document.documentElement.dataset.nativeUserscriptMessage;
+        if (value) return resolve(JSON.parse(value));
+        if (Date.now() > deadline) return reject(new Error('No native userscript message reply'));
+        setTimeout(poll, 20);
+      };
+      poll();
+    })`);
+    assert.equal(reply.nonce, 'native-world-message');
+    assert.equal(reply.extensionId, extension.id);
+    assert.equal(reply.url, target.webContents.getURL());
+  }
+  await target.loadURL(`http://127.0.0.1:${server.address().port}/unmatched`);
+  assert.equal(await target.webContents.executeJavaScript('document.documentElement.dataset.nativeUserscript'), undefined);
+  console.log(JSON.stringify({ phase, injected: shouldExecute, allowed: custom.extensions.getUserScriptsAllowed(extension.id), runtime: { electron: process.versions.electron, chromium: process.versions.chrome, platform: process.platform, arch: process.arch } }));
+  target.destroy();
+  controller.destroy();
+  server.close();
+  app.quit();
+}).catch(error => {
+  console.error(error.stack || error);
+  if (target) target.destroy();
+  if (controller) controller.destroy();
+  if (server) server.close();
+  app.exit(1);
+});
