+ExtensionFunction::ResponseAction TabsCreateFunction::Run() {
+  const auto* properties = args().size() == 1 ? args()[0].GetIfDict() : nullptr;
+  const auto* url = properties ? properties->FindString("url") : nullptr;
+  if (!url || url->empty())
+    return RespondNow(Error("An extension page URL is required."));
+  const Extension* caller = extension();
+  if (!caller)
+    return RespondNow(Error("An extension is required to create a tab."));
+
+  const GURL target = caller->url().Resolve(*url);
+  if (!target.is_valid() || !target.SchemeIs(kExtensionScheme) ||
+      target.host() != caller->id() || target.has_username() ||
+      target.has_password() || target.has_port()) {
+    return RespondNow(Error("This host only opens the calling extension's pages."));
+  }
+
+  auto* isolate = electron::JavascriptEnvironment::GetIsolate();
+  v8::HandleScope scope(isolate);
+  auto* cell = electron::api::Session::FromBrowserContext(browser_context());
+  auto* session = cell ? cell->Get() : nullptr;
+  if (!session)
+    return RespondNow(Error("No extension tab creation handler for this session."));
+
+  bool active = properties->FindBool("active").value_or(true);
+  v8::TryCatch try_catch(isolate);
+  int id = session->Extensions(isolate)->RequestTabCreation(caller->id(), target.spec(), active);
+  if (try_catch.HasCaught() || id <= 0 || !GetElectronTabById(id, browser_context()))
+    return RespondNow(Error("The host refused to open this extension page."));
+
+  base::DictValue result;
+  result.Set("id", id);
+  result.Set("index", 0);
+  result.Set("windowId", id);
+  result.Set("groupId", -1);
+  result.Set("active", active);
+  result.Set("highlighted", active);
+  result.Set("selected", active);
+  result.Set("pinned", false);
+  result.Set("frozen", false);
+  result.Set("discarded", false);
+  result.Set("autoDiscardable", false);
+  result.Set("lastAccessed", base::Time::Now().InMillisecondsFSinceUnixEpoch());
+  result.Set("status", "loading");
+  result.Set("pendingUrl", target.spec());
+  return RespondNow(WithArguments(std::move(result)));
+}
